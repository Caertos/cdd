{
  "name": "cdd-cli",
  "version": "4.7.1",
  "description": "CLI Docker Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "build": "NODE_ENV=production babel src --out-dir dist --extensions .js,.jsx && node fix-imports.cjs",
    "changes": "pnpm run build && node dist/index.js",
    "lint": "eslint src --ext .js,.jsx",
    "docs": "jsdoc -r -d docs src",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "docker",
    "cli",
    "tui",
    "dashboard",
    "container",
    "terminal"
  ],
  "author": "caertos",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caertos/cdd.git"
  },
  "homepage": "https://github.com/Caertos/cdd#readme",
  "bugs": {
    "url": "https://github.com/Caertos/cdd/issues"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "chalk": "^6.0.0",
    "dockerode": "^5",
    "ink": "^6.3.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "bin": {
    "cdd": "dist/index.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^30.5.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^30.5.2",
    "jsdoc": "^4.0.5",
    "prettier": "^3.8.3"
  }
}
